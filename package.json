{
  "name": "hello-po",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:agent": "npm run dev -w @hello-po/agent",
    "dev:token": "npm run dev -w @hello-po/token-server",
    "dev:web": "npm run dev -w @hello-po/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "latency:report": "node scripts/latency-report.ts"
  },
  "dependencies": {
    "@livekit/agents": "1.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
