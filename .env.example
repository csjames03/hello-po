# Hello Po: environment variables
# Copy to .env and fill in. Never commit .env.
# All providers are free tier with NO credit card, so overflow fails instead of billing.

# --- LiveKit Cloud (cloud.livekit.io -> your project -> Settings -> Keys) ---
# WebSocket URL of your project, e.g. wss://hello-po-xxxx.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram (console.deepgram.com -> API Keys) --- used for STT and TTS
DEEPGRAM_API_KEY=

# --- Groq (console.groq.com -> API Keys) --- LLM
GROQ_API_KEY=

# --- Supabase (supabase.com -> project -> Settings -> API) --- needed from Phase 2
SUPABASE_URL=
# Secret key (sb_secret_...) from Project Settings -> API Keys. Server-side only, never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Demo guardrails ---
# Passcode visitors must enter before a call is allowed
DEMO_PASSCODE=
# Set to true to block new calls (kill switch)
DEMO_PAUSED=false
# Hard session limit; agent says goodbye and disconnects
MAX_SESSION_SECONDS=120

# --- Optional overrides (defaults shown) ---
# LLM_MODEL=qwen/qwen3.8-27b
# STT_MODEL=flux-general-en   # or nova-3
# TTS_VOICE=aura-2-asteria-en
# TOKEN_SERVER_PORT=3001

# --- Booking flow (Phase 4a): read by the token server only ---
# Stripe test-mode secret key (Developers -> API keys, starts with sk_test_). Never use a live key.
STRIPE_SECRET_KEY=
# Optional. Signing secret printed by `stripe listen --forward-to localhost:3001/api/stripe/webhook`.
# Without it, payments are still confirmed by polling Stripe from the booking form.
STRIPE_WEBHOOK_SECRET=
# Resend API key for confirmation emails (resend.com/api-keys, starts with re_).
# Without a verified domain, Resend only delivers to your own Resend account address.
RESEND_API_KEY=
# Optional sender. The default works without a domain.
EMAIL_FROM=Isla Azul Beach Resort <onboarding@resend.dev>
# Where Stripe sends the caller after paying.
WEB_URL=http://localhost:5173
